---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../config/site';
---

<BaseLayout
  title="Pedido Recebido | PMVP — Terrenos & Urbanismo"
  description="Recebemos o seu pedido de análise de terreno. Confirmamos em até 24 horas úteis."
  noindex={true}
>
  <section class="py-16 sm:py-24 bg-stone/50">
    <div class="container-pmvp max-w-2xl">
      <div class="rounded-xl border border-border bg-white p-8 sm:p-10 shadow-sm text-center">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-pine text-white">
          <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </div>

        <span class="mt-4 inline-block rounded bg-stone px-3 py-1 font-mono text-xs font-semibold text-pine">
          Referência: <span id="order-id-display">PMVP-2026-0001</span>
        </span>

        <h1 class="mt-4 font-serif text-3xl sm:text-4xl font-semibold text-pine">
          Recebemos o seu pedido.
        </h1>

        <p class="mt-4 text-base sm:text-lg text-graphite leading-relaxed">
          Vamos confirmar em até <strong>24 horas úteis</strong> se temos a informação necessária e enviar a proposta e os dados de pagamento.
        </p>

        <div class="mt-8 rounded-lg border border-border bg-stone/40 p-5 text-left text-sm space-y-2.5">
          <h2 class="font-serif text-base font-semibold text-pine">
            O que acontece a seguir?
          </h2>
          <ol class="list-decimal list-inside space-y-2 text-graphite-muted">
            <li>Enviámos um e-mail de confirmação para o endereço que nos indicou.</li>
            <li>A nossa equipa técnica valida a localização, os dados cadastrais e os ficheiros submetidos.</li>
            <li>Recebe a confirmação e os dados de pagamento em até 24 horas úteis.</li>
            <li>O prazo de entrega conta a partir da confirmação e pagamento.</li>
          </ol>
        </div>

        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a href="/" class="btn-primary w-full sm:w-auto">
            Voltar à página inicial
          </a>
          <a href="/recursos" class="btn-secondary w-full sm:w-auto">
            Ler artigos sobre terrenos e PDM
          </a>
        </div>

        <p class="mt-6 text-xs text-graphite-muted">
          Alguma dúvida ou documento adicional? Escreva-nos para <span class="font-mono text-pine font-medium">{SITE_CONFIG.contact.teamEmail}</span> indicando a referência do pedido.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const params = new URLSearchParams(window.location.search);
    const id = params.get('id');
    const produto = params.get('produto') || 'geral';
    const perfil = params.get('perfil') || 'nao-definido';
    const concelho = params.get('concelho') || 'nao-definido';

    const idEl = document.getElementById('order-id-display');
    if (id && idEl) {
      idEl.textContent = id;
    }

    // Dispara evento de conversão (GA4 / Google Ads / Meta Pixel se consentido)
    const w = window as unknown as { pmvpTrack?: (n: string, p: Record<string, unknown>) => void };
    if (typeof w.pmvpTrack === 'function') {
      w.pmvpTrack('form_submit', {
        produto,
        perfil,
        concelho,
        order_id: id || 'PMVP',
        page: '/obrigado',
      });
    }
  });
</script>
