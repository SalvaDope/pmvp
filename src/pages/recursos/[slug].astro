---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CartographicVisual from '../../components/CartographicVisual.astro';
import { SITE_CONFIG, type ArticleConfig } from '../../config/site';

export function getStaticPaths() {
  return SITE_CONFIG.articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: ArticleConfig;
}

const { article } = Astro.props;
const { raioX } = SITE_CONFIG.products;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.excerpt,
  datePublished: article.publishedAt,
  dateModified: article.publishedAt,
  author: {
    '@type': 'Organization',
    name: `${SITE_CONFIG.brand.name} — ${SITE_CONFIG.brand.descriptor}`,
  },
  publisher: {
    '@type': 'Organization',
    name: `${SITE_CONFIG.brand.name} — ${SITE_CONFIG.brand.descriptor}`,
  },
  articleSection: article.category,
};

const relatedArticles = SITE_CONFIG.articles
  .filter((a) => a.slug !== article.slug)
  .slice(0, 3);
---

<BaseLayout
  title={`${article.title} | PMVP`}
  description={article.excerpt}
  ogType="article"
  schema={articleSchema}
>
  <article class="py-12 sm:py-16 lg:py-20 bg-white">
    <div class="container-pmvp max-w-3xl">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="mb-6 text-xs font-medium text-graphite-muted">
        <a href="/" class="hover:text-pine">Início</a>
        <span class="mx-2">/</span>
        <a href="/recursos" class="hover:text-pine">Recursos</a>
        <span class="mx-2">/</span>
        <span class="text-pine">{article.category}</span>
      </nav>

      <!-- Meta & Título -->
      <div class="flex flex-wrap items-center gap-3 text-xs text-graphite-muted mb-4">
        <span class="rounded bg-stone px-2.5 py-1 font-semibold text-pine">
          {article.category}
        </span>
        <time datetime={article.publishedAt}>{article.publishedLabel}</time>
        <span>·</span>
        <span>{article.readingTime}</span>
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl lg:text-[42px] font-semibold text-pine leading-tight">
        {article.title}
      </h1>

      <p class="mt-4 text-base sm:text-lg text-graphite-muted leading-relaxed">
        {article.excerpt}
      </p>

      <!-- Marcador de Texto Editorial -->
      <div class="mt-6 rounded-md border border-terracotta/40 bg-terracotta-muted/50 px-4 py-2.5">
        <span class="font-mono text-xs font-medium text-terracotta-dark">
          {article.placeholderNotice}
        </span>
      </div>

      <!-- Imagem Cartográfica com Marcador -->
      <div class="my-8">
        <CartographicVisual marker={article.imagePlaceholder} variant="pdm" />
      </div>

      <!-- Resumo de Pontos-Chave -->
      <div class="my-8 rounded-xl border border-pine/25 bg-stone/50 p-6">
        <h2 class="font-serif text-lg font-semibold text-pine mb-3">
          Em síntese
        </h2>
        <ul class="space-y-2 text-sm text-graphite">
          {article.keyTakeaways.map((point) => (
            <li class="flex items-start gap-2.5">
              <span class="mt-1 h-2 w-2 rounded-full bg-terracotta shrink-0"></span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Corpo do Artigo -->
      <div class="space-y-8 text-base text-graphite leading-relaxed">
        {article.sections.map((sec) => (
          <section class="space-y-3">
            <h2 class="font-serif text-xl sm:text-2xl font-semibold text-pine">
              {sec.heading}
            </h2>
            {sec.paragraphs.map((p) => (
              <p>{p}</p>
            ))}
          </section>
        ))}
      </div>

      <!-- CTA obrigatório no final de cada artigo para o Raio-X (Secção 6.11) -->
      <div class="mt-12 rounded-xl bg-pine text-white p-6 sm:p-8 shadow-md">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
          <div class="space-y-2">
            <span class="inline-block rounded bg-terracotta px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wider text-white">
              Comece pelo Raio-X
            </span>
            <h2 class="font-serif text-2xl font-semibold text-white">
              Tem um terreno e quer uma resposta fundamentada?
            </h2>
            <p class="text-sm text-stone/90 leading-relaxed">
              Com o <strong>{raioX.name}</strong> ({raioX.priceDisplay} {raioX.vatLabel} <span class="font-mono text-xs text-terracotta-light">{raioX.placeholderTag}</span>), analisamos o PDM e as principais condicionantes do seu terreno em {raioX.turnaround}. O valor é descontado se avançar para o Estudo de Viabilidade em 90 dias.
            </p>
          </div>
          <div class="shrink-0">
            <a
              href={raioX.ctaHref}
              data-track-cta={`article_footer_${article.slug}`}
              data-track-product="raio-x"
              class="btn-terracotta w-full sm:w-auto"
            >
              {raioX.ctaLabel}
            </a>
          </div>
        </div>
      </div>
    </div>
  </article>

  <!-- Artigos Relacionados -->
  <section class="py-12 sm:py-16 bg-stone/50 border-t border-border">
    <div class="container-pmvp max-w-5xl">
      <div class="flex items-center justify-between mb-8">
        <h2 class="font-serif text-2xl font-semibold text-pine">
          Outros artigos técnicos
        </h2>
        <a href="/recursos" class="text-sm font-semibold text-pine underline">
          Ver todos os artigos →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {relatedArticles.map((rel) => (
          <a href={`/recursos/${rel.slug}`} class="card-pmvp hover:border-pine group flex flex-col justify-between">
            <div>
              <span class="text-xs font-semibold text-terracotta">{rel.category}</span>
              <h3 class="mt-2 font-serif text-lg font-semibold text-pine group-hover:text-terracotta transition-colors">
                {rel.title}
              </h3>
              <p class="mt-2 text-xs text-graphite-muted line-clamp-3">
                {rel.excerpt}
              </p>
            </div>
            <span class="mt-4 text-xs font-semibold text-pine">Ler artigo →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
