---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../config/site';

const { raioX, estudo, valor, pip } = SITE_CONFIG.products;
const allProducts = [raioX, estudo, valor, pip];
---

<BaseLayout
  title="Serviços e Preços de Análise de Terrenos | PMVP — Grande Lisboa"
  description="Conheça os serviços da PMVP: Raio-X do Terreno (190 €), Estudo de Viabilidade (desde 1.190 €), Estimativa de Valor por Cenário (+690 €) e Pedido de Informação Prévia (PIP)."
>
  <section class="py-12 sm:py-16 lg:py-20 bg-stone/70 border-b border-border">
    <div class="container-pmvp max-w-4xl">
      <span class="text-xs font-semibold uppercase tracking-wider text-terracotta">
        Serviços & Preços
      </span>
      <h1 class="mt-2 font-serif text-3xl sm:text-5xl font-semibold text-pine">
        Análise técnica para cada fase da sua decisão
      </h1>
      <p class="mt-4 text-base sm:text-lg text-graphite leading-relaxed">
        Comece por uma primeira leitura rápida com o Raio-X ou peça uma análise regulamentar, cartográfica e documental completa com o Estudo de Viabilidade. Preços para consumidores apresentados com IVA incluído.
      </p>
    </div>
  </section>

  <!-- Grelha dos 4 Produtos -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="container-pmvp">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {allProducts.map((prod) => (
          <div
            id={prod.id}
            class="card-pmvp flex flex-col justify-between border-border hover:border-pine/60 scroll-mt-24"
          >
            <div>
              <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <span class="rounded bg-stone px-2.5 py-1 text-xs font-semibold text-pine">
                  {prod.badge}
                </span>
                <span class="text-xs font-medium text-graphite-muted">
                  Prazo: <strong>{prod.turnaround}</strong>
                </span>
              </div>

              <h2 class="font-serif text-2xl font-semibold text-pine">
                {prod.name}
              </h2>

              <div class="mt-3 flex flex-wrap items-baseline gap-2">
                <span class="font-serif text-3xl font-semibold text-pine">
                  {prod.priceDisplay}
                </span>
                {prod.vatLabel && (
                  <span class="text-xs text-graphite-muted">{prod.vatLabel}</span>
                )}
                {prod.placeholderTag && (
                  <span class="placeholder-tag">{prod.placeholderTag}</span>
                )}
              </div>

              <p class="mt-4 text-sm sm:text-base text-graphite leading-relaxed">
                {prod.summary}
              </p>

              <p class="mt-3 text-xs font-medium text-terracotta-dark bg-terracotta-muted/50 rounded px-3 py-2">
                Nota: {prod.notes}
              </p>
            </div>

            <div class="mt-6 pt-5 border-t border-border flex flex-wrap items-center justify-between gap-3">
              <a
                href={prod.ctaHref}
                data-track-cta={`servicos_card_${prod.id}`}
                data-track-product={prod.id}
                class="btn-primary text-sm py-2.5 px-5"
              >
                {prod.ctaLabel}
              </a>
              {(prod.id === 'raio-x' || prod.id === 'estudo') && (
                <a href={prod.href} class="text-xs font-semibold text-pine hover:underline">
                  Ver página detalhada →
                </a>
              )}
            </div>
          </div>
        ))}
      </div>

      <!-- Destaque detalhado do PIP (Secção 6.4) -->
      <div class="mt-12 rounded-xl border border-pine/30 bg-stone/50 p-6 sm:p-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
          <div class="lg:col-span-8 space-y-3">
            <span class="text-xs font-semibold uppercase tracking-wider text-terracotta">
              Do Estudo à Câmara Municipal
            </span>
            <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-pine">
              Pedido de Informação Prévia (PIP)
            </h2>
            <p class="text-sm sm:text-base text-graphite leading-relaxed">
              Preparação, submissão e acompanhamento do Pedido de Informação Prévia, com arquitetos parceiros, até à decisão municipal. Disponível depois do Estudo de Viabilidade.
            </p>
          </div>
          <div class="lg:col-span-4 flex lg:justify-end">
            <a
              href="/submeter-terreno?produto=aconselhamento"
              data-track-cta="servicos_pip_cta"
              data-track-product="pip"
              class="btn-terracotta w-full sm:w-auto"
            >
              Pedir aconselhamento
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
