---
import BaseLayout from '../layouts/BaseLayout.astro';
import CartographicVisual from '../components/CartographicVisual.astro';
import FaqSection from '../components/FaqSection.astro';
import { SITE_CONFIG } from '../config/site';

const { raioX, estudo } = SITE_CONFIG.products;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: raioX.name,
  provider: {
    '@type': 'ProfessionalService',
    name: `${SITE_CONFIG.brand.name} — ${SITE_CONFIG.brand.descriptor}`,
  },
  areaServed: SITE_CONFIG.geography.pilotDescription,
  description: raioX.summary,
  offers: {
    '@type': 'Offer',
    price: '190.00',
    priceCurrency: 'EUR',
    description: `${raioX.priceDisplay} ${raioX.vatLabel} ${raioX.placeholderTag} — ${raioX.notes}`,
  },
};

const includedItems = [
  'Identificação e localização do terreno (com base nos dados que nos envia)',
  'Classificação e qualificação do solo no PDM em vigor',
  'Verificação das principais condicionantes: RAN, REN, linhas elétricas, servidões, domínio hídrico, património',
  'Semáforo de viabilidade por uso: habitação · indústria/logística · agrícola',
  'Recomendação do passo seguinte',
  'Relatório PDF de 4–5 páginas com mapa',
];

const excludedItems = [
  'Leitura detalhada do regulamento do PDM e índices urbanísticos',
  'Cálculo de áreas de construção, cérceas ou número de pisos',
  'Estimativa de valor de mercado do terreno',
  'Contacto ou reuniões com a Câmara Municipal',
];
---

<BaseLayout
  title="Raio-X do Terreno — saiba o que pode construir | PMVP"
  description="A primeira leitura técnica do seu terreno na Grande Lisboa, em 5 dias úteis, por 190 € (IVA incl.). Classificação no PDM, RAN, REN e semáforo de viabilidade."
  schema={serviceSchema}
>
  <!-- Hero -->
  <section class="py-12 sm:py-16 lg:py-20 bg-stone/70 border-b border-border">
    <div class="container-pmvp">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-5">
          <span class="inline-block rounded-full bg-pine/10 px-3.5 py-1 text-xs font-semibold text-pine">
            {raioX.badge} · Entrega em {raioX.turnaround}
          </span>
          <h1 class="font-serif text-3xl sm:text-5xl font-semibold text-pine">
            {raioX.name}
          </h1>
          <p class="text-lg sm:text-xl text-graphite leading-relaxed">
            A primeira leitura técnica do seu terreno, em {raioX.turnaround}, por <strong>{raioX.priceDisplay}</strong> <span class="text-sm text-graphite-muted">{raioX.vatLabel}</span> <span class="placeholder-tag">{raioX.placeholderTag}</span>.
          </p>
          <p class="text-sm sm:text-base text-graphite-muted leading-relaxed">
            Ideal para uma triagem rápida e fundamentada antes de visitar um terreno para compra, iniciar uma negociação ou decidir se justifica avançar para um Estudo de Viabilidade completo.
          </p>
          <div class="pt-2 flex flex-col sm:flex-row gap-3.5">
            <a
              href={raioX.ctaHref}
              data-track-cta="raiox_hero"
              data-track-product="raio-x"
              class="btn-terracotta text-base px-7 py-3.5"
            >
              {raioX.ctaLabel}
            </a>
            <a href="/estudo-de-viabilidade" class="btn-secondary text-base px-6 py-3.5">
              Comparar com o Estudo de Viabilidade
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <CartographicVisual
            marker="[IMG: Excerto de relatório Raio-X com mapa de condicionantes e semáforo de viabilidade]"
            caption="Exemplo de enquadramento cartográfico incluído no relatório PDF de 4–5 páginas."
            variant="pdm"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- O que inclui / O que não inclui -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="container-pmvp">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
        <!-- O que inclui -->
        <div class="lg:col-span-7 rounded-xl border border-pine/30 bg-stone/30 p-6 sm:p-8">
          <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-pine">
            O que inclui o Raio-X
          </h2>
          <p class="mt-2 text-sm text-graphite-muted">
            Tudo o que precisa para uma primeira triagem técnica das potencialidades e restrições da parcela:
          </p>
          <ul class="mt-6 space-y-4">
            {includedItems.map((item) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-pine text-white">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <span class="text-sm sm:text-base text-graphite font-medium">{item}</span>
              </li>
            ))}
          </ul>

          <!-- Exemplo visual do Semáforo de Viabilidade -->
          <div class="mt-8 rounded-lg border border-border bg-white p-5">
            <div class="text-xs font-semibold uppercase tracking-wider text-pine mb-3">
              Exemplo de Semáforo de Viabilidade por Uso (incluído no relatório)
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
              <div class="rounded border border-border p-3 bg-stone/30">
                <div class="flex items-center gap-2 font-semibold text-pine">
                  <span class="h-3 w-3 rounded-full bg-amber-500"></span>
                  <span>Habitação</span>
                </div>
                <p class="mt-1 text-graphite-muted">Condicionado à dimensão mínima e parecer sobre faixa lateral.</p>
              </div>
              <div class="rounded border border-border p-3 bg-stone/30">
                <div class="flex items-center gap-2 font-semibold text-pine">
                  <span class="h-3 w-3 rounded-full bg-red-600"></span>
                  <span>Indústria / Logística</span>
                </div>
                <p class="mt-1 text-graphite-muted">Desfavorável na categoria de espaço atual do PDM.</p>
              </div>
              <div class="rounded border border-border p-3 bg-stone/30">
                <div class="flex items-center gap-2 font-semibold text-pine">
                  <span class="h-3 w-3 rounded-full bg-emerald-600"></span>
                  <span>Uso Agrícola</span>
                </div>
                <p class="mt-1 text-graphite-muted">Favorável (apoio agrícola admitido nos termos do PDM).</p>
              </div>
            </div>
          </div>
        </div>

        <!-- O que não inclui + Bloco de Preço -->
        <div class="lg:col-span-5 space-y-6">
          <div class="rounded-xl border border-border bg-white p-6 sm:p-8">
            <h2 class="font-serif text-xl sm:text-2xl font-semibold text-graphite">
              O que não inclui
            </h2>
            <p class="mt-2 text-xs sm:text-sm text-graphite-muted">
              O Raio-X não inclui leitura detalhada do regulamento do PDM, cálculo de áreas de construção, estimativa de valor e contacto com a Câmara. Estes estão no <a href={estudo.href} class="text-pine font-semibold underline">{estudo.name}</a>:
            </p>
            <ul class="mt-4 space-y-3">
              {excludedItems.map((item) => (
                <li class="flex items-start gap-2.5 text-sm text-graphite-muted">
                  <span class="mt-0.5 text-graphite-light font-mono">—</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Bloco de Preço -->
          <div class="rounded-xl bg-pine text-white p-6 sm:p-8 shadow-md">
            <span class="text-xs font-semibold uppercase tracking-wider text-stone/80">
              Condições e Prazo
            </span>
            <div class="mt-2 flex items-baseline gap-2">
              <span class="font-serif text-4xl font-semibold text-white">{raioX.priceDisplay}</span>
              <span class="text-sm text-stone/85">{raioX.vatLabel}</span>
              <span class="placeholder-tag bg-white/15 text-stone border-stone/30">{raioX.placeholderTag}</span>
            </div>

            <ul class="mt-4 space-y-2 text-sm text-stone/90">
              <li>• <strong>Prazo:</strong> {raioX.turnaround} após confirmação e pagamento.</li>
              <li>• <strong>Crédito de 100%:</strong> O valor é descontado no Estudo de Viabilidade, se avançar em 90 dias.</li>
            </ul>

            <div class="mt-6">
              <a
                href={raioX.ctaHref}
                data-track-cta="raiox_pricing_card"
                data-track-product="raio-x"
                class="btn-terracotta w-full text-base py-3.5"
              >
                {raioX.ctaLabel}
              </a>
            </div>

            <p class="mt-4 text-[11px] text-stone/70 leading-relaxed">
              Aviso: O Raio-X é uma análise preliminar baseada em informação pública oficial e não substitui a informação prévia ou decisão da Câmara Municipal.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FaqSection />
</BaseLayout>
