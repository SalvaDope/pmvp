---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../config/site';

const audiences = [
  {
    title: 'Mediadores e consultores imobiliários',
    desc: 'Qualifique terrenos antes de angariar, defenda o valor pedido e dê segurança técnica imediata aos compradores.',
  },
  {
    title: 'Advogados e sociedades de advogados',
    desc: 'Apoio técnico urbanístico e fundiário em processos de compra e venda, due diligence, partilhas e contencioso.',
  },
  {
    title: 'Solicitadores',
    desc: 'Cruzamento técnico entre registo predial, matriz, BUPi, cadastro geométrico e condicionantes do PDM.',
  },
  {
    title: 'Contabilistas e gestores de património',
    desc: 'Análise de viabilidade e estimativa de valor por cenário para tomada de decisão sobre ativos imobiliários familiares ou societários.',
  },
];

const benefits = [
  {
    title: 'Condições de parceiro em packs de análises',
    desc: 'Condições dedicadas para profissionais com volume recorrente de terrenos na Grande Lisboa. Condições sob contacto.',
  },
  {
    title: 'Relatórios com linguagem clara para o cliente final',
    desc: 'Documentos rigorosos mas acessíveis, prontos a partilhar com proprietários, herdeiros ou investidores.',
  },
  {
    title: 'Resposta rápida e canal direto',
    desc: 'Validação em 24 horas úteis e acompanhamento direto com a nossa direção técnica.',
  },
];
---

<BaseLayout
  title="Parceiros Profissionais | PMVP — Terrenos & Urbanismo"
  description="Para mediadores imobiliários, advogados, solicitadores e contabilistas: análises técnicas de terrenos para os seus clientes na Grande Lisboa."
>
  <section class="py-12 sm:py-16 lg:py-20 bg-stone/70 border-b border-border">
    <div class="container-pmvp max-w-4xl">
      <span class="inline-block rounded-full bg-pine/10 px-3.5 py-1 text-xs font-semibold text-pine">
        Parcerias Profissionais · Condições sob contacto
      </span>
      <h1 class="mt-3 font-serif text-3xl sm:text-5xl font-semibold text-pine leading-tight">
        Para profissionais: análises de terrenos para os seus clientes.
      </h1>
      <p class="mt-4 text-base sm:text-lg text-graphite leading-relaxed">
        Trabalhamos em articulação com mediadores imobiliários, advogados, solicitadores, contabilistas e gestores de património que necessitam de pareceres técnicos independentes sobre terrenos. A PMVP não faz mediação imobiliária.
      </p>
    </div>
  </section>

  <section class="py-16 lg:py-24 bg-white">
    <div class="container-pmvp">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <!-- Coluna Esquerda: Para quem e Benefícios -->
        <div class="lg:col-span-6 space-y-10">
          <div>
            <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-pine">
              Com quem colaboramos
            </h2>
            <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
              {audiences.map((aud) => (
                <div class="rounded-lg border border-border bg-stone/30 p-5">
                  <h3 class="font-serif text-base font-semibold text-pine">
                    {aud.title}
                  </h3>
                  <p class="mt-2 text-xs sm:text-sm text-graphite-muted leading-relaxed">
                    {aud.desc}
                  </p>
                </div>
              ))}
            </div>
          </div>

          <div>
            <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-pine">
              Benefícios para parceiros
            </h2>
            <div class="mt-6 space-y-4">
              {benefits.map((b) => (
                <div class="flex items-start gap-3.5 rounded-lg border border-border bg-white p-5 shadow-sm">
                  <span class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-pine text-white">
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </span>
                  <div>
                    <h3 class="font-serif text-lg font-semibold text-pine">
                      {b.title}
                    </h3>
                    <p class="mt-1 text-sm text-graphite-muted leading-relaxed">
                      {b.desc}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="rounded-lg border border-pine/20 bg-stone p-5 text-sm text-graphite">
            <strong class="text-pine">Já tem um terreno específico de um cliente para analisar agora?</strong>
            <p class="mt-1 text-graphite-muted">
              Pode submetê-lo diretamente no formulário de análise selecionando o perfil Profissional.
            </p>
            <a
              href="/submeter-terreno?perfil=profissional"
              class="mt-3 inline-block font-semibold text-pine underline hover:text-terracotta"
            >
              Submeter terreno de cliente →
            </a>
          </div>
        </div>

        <!-- Coluna Direita: Formulário de Parceiros -->
        <div class="lg:col-span-6">
          <div class="rounded-xl border border-border bg-stone/40 p-6 sm:p-8 shadow-sm">
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="text-xs font-semibold uppercase tracking-wider text-terracotta">
                Protocolos & Packs
              </span>
              <span class="rounded bg-pine px-2.5 py-0.5 text-xs font-medium text-white">
                Condições sob contacto
              </span>
            </div>
            <h2 class="font-serif text-2xl font-semibold text-pine">
              Falar connosco sobre parceria
            </h2>
            <p class="mt-1 text-sm text-graphite-muted">
              Deixe os seus dados profissionais para lhe apresentarmos as condições de parceiro.
            </p>

            <div
              id="partner-success"
              class="hidden mt-6 rounded-lg border border-pine bg-pine text-white p-5 text-sm"
            >
              <p class="font-serif text-lg font-semibold">Pedido recebido com sucesso.</p>
              <p class="mt-1 text-stone/90">
                Obrigado pelo seu contacto. A nossa direção comercial entrará em contacto consigo brevemente para apresentar as condições de parceiro.
              </p>
            </div>

            <div
              id="partner-error"
              class="hidden mt-6 rounded-lg border border-terracotta bg-terracotta-muted p-4 text-sm text-terracotta-dark"
            ></div>

            <form id="partner-form" action="/api/parceiros" method="POST" class="mt-6 space-y-4">
              <div class="hidden" aria-hidden="true">
                <label for="company_website_hp">Não preencher</label>
                <input type="text" id="company_website_hp" name="company_website_hp" tabindex="-1" autocomplete="off" />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="p-nome" class="block text-sm font-medium text-pine mb-1">
                    Nome <span class="text-terracotta">*</span>
                  </label>
                  <input
                    type="text"
                    id="p-nome"
                    name="nome"
                    required
                    class="w-full rounded-md border border-border bg-white px-3.5 py-2 text-sm text-graphite"
                  />
                </div>

                <div>
                  <label for="p-empresa" class="block text-sm font-medium text-pine mb-1">
                    Empresa / Sociedade
                  </label>
                  <input
                    type="text"
                    id="p-empresa"
                    name="empresa"
                    class="w-full rounded-md border border-border bg-white px-3.5 py-2 text-sm text-graphite"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="p-profissao" class="block text-sm font-medium text-pine mb-1">
                    Profissão <span class="text-terracotta">*</span>
                  </label>
                  <select
                    id="p-profissao"
                    name="profissao"
                    required
                    class="w-full rounded-md border border-border bg-white px-3.5 py-2 text-sm text-graphite"
                  >
                    <option value="">Selecione...</option>
                    <option value="Mediador / Consultor Imobiliário">Mediador / Consultor Imobiliário</option>
                    <option value="Advogado">Advogado</option>
                    <option value="Solicitador">Solicitador</option>
                    <option value="Contabilista / Gestor de Património">Contabilista / Gestor de Património</option>
                    <option value="Arquiteto / Engenheiro">Arquiteto / Engenheiro</option>
                    <option value="Outro">Outro</option>
                  </select>
                </div>

                <div>
                  <label for="p-terrenos-ano" class="block text-sm font-medium text-pine mb-1">
                    N.º estimado de terrenos/ano
                  </label>
                  <select
                    id="p-terrenos-ano"
                    name="terrenos_ano"
                    class="w-full rounded-md border border-border bg-white px-3.5 py-2 text-sm text-graphite"
                  >
                    <option value="1 a 5 terrenos/ano">1 a 5 terrenos/ano</option>
                    <option value="6 a 15 terrenos/ano">6 a 15 terrenos/ano</option>
                    <option value="Mais de 15 terrenos/ano">Mais de 15 terrenos/ano</option>
                  </select>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="p-email" class="block text-sm font-medium text-pine mb-1">
                    E-mail <span class="text-terracotta">*</span>
                  </label>
                  <input
                    type="email"
                    id="p-email"
                    name="email"
                    required
                    class="w-full rounded-md border border-border bg-white px-3.5 py-2 text-sm text-graphite"
                  />
                </div>

                <div>
                  <label for="p-telemovel" class="block text-sm font-medium text-pine mb-1">
                    Telemóvel <span class="text-terracotta">*</span>
                  </label>
                  <input
                    type="tel"
                    id="p-telemovel"
                    name="telemovel"
                    required
                    placeholder="+351 910 000 000"
                    class="w-full rounded-md border border-border bg-white px-3.5 py-2 text-sm text-graphite"
                  />
                </div>
              </div>

              <div>
                <label for="p-mensagem" class="block text-sm font-medium text-pine mb-1">
                  Mensagem
                </label>
                <textarea
                  id="p-mensagem"
                  name="mensagem"
                  rows="3"
                  placeholder="Conte-nos brevemente como podemos colaborar..."
                  class="w-full rounded-md border border-border bg-white p-3.5 text-sm text-graphite"
                ></textarea>
              </div>

              <p class="text-xs text-graphite-muted">
                Ao submeter este formulário, concorda com o tratamento dos seus dados para contacto profissional nos termos da nossa <a href="/privacidade" class="underline text-pine">Política de Privacidade</a>.
              </p>

              <button type="submit" id="partner-submit-btn" class="btn-primary w-full py-3">
                Pedir condições de parceiro
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('partner-form') as HTMLFormElement | null;
  const successEl = document.getElementById('partner-success');
  const errorEl = document.getElementById('partner-error');
  const submitBtn = document.getElementById('partner-submit-btn') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl?.classList.add('hidden');
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'A enviar...';
    }

    try {
      const formData = new FormData(form);
      const res = await fetch('/api/parceiros', {
        method: 'POST',
        body: formData,
      });
      const data = await res.json();

      if (!res.ok || !data.ok) {
        if (errorEl) {
          errorEl.textContent = data.error || 'Erro ao enviar pedido.';
          errorEl.classList.remove('hidden');
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Pedir condições de parceiro';
        }
        return;
      }

      const w = window as unknown as { pmvpTrack?: (n: string, p: Record<string, unknown>) => void };
      if (typeof w.pmvpTrack === 'function') {
        w.pmvpTrack('partner_form_submit', {
          profissao: String(formData.get('profissao') || ''),
          terrenos_ano: String(formData.get('terrenos_ano') || ''),
        });
      }

      form.classList.add('hidden');
      successEl?.classList.remove('hidden');
    } catch {
      if (errorEl) {
        errorEl.textContent = 'Erro de ligação. Tente novamente.';
        errorEl.classList.remove('hidden');
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Pedir condições de parceiro';
      }
    }
  });
</script>
