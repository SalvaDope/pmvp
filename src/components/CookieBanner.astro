---
import { SITE_CONFIG } from '../config/site';
---

<!-- Banner de Consentimento de Cookies (RGPD) -->
<div
  id="cookie-banner"
  role="dialog"
  aria-modal="false"
  aria-labelledby="cookie-banner-title"
  class="fixed bottom-0 inset-x-0 z-50 hidden border-t border-border bg-white p-4 sm:p-6 shadow-2xl"
>
  <div class="container-pmvp">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
      <div class="max-w-3xl space-y-1.5">
        <h2 id="cookie-banner-title" class="font-serif text-base sm:text-lg font-semibold text-pine">
          Privacidade e utilização de cookies
        </h2>
        <p class="text-xs sm:text-sm text-graphite-muted leading-relaxed">
          Utilizamos cookies estritamente necessários ao funcionamento do website (como guardar o rascunho do formulário) e, mediante o seu consentimento, cookies analíticos (GA4) e de publicidade (Google Ads e Meta Pixel) para medir o desempenho das nossas campanhas. Pode aceitar, rejeitar ou configurar as suas preferências a qualquer momento. Consulte a nossa <a href="/cookies" class="underline text-pine font-medium">Política de Cookies</a> e <a href="/privacidade" class="underline text-pine font-medium">Política de Privacidade</a>.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2.5 shrink-0">
        <button
          type="button"
          id="cookie-btn-configure"
          class="rounded-md border border-border bg-white px-3.5 py-2 text-xs sm:text-sm font-medium text-graphite hover:bg-stone transition-colors"
        >
          Configurar
        </button>
        <button
          type="button"
          id="cookie-btn-reject"
          class="rounded-md border border-pine/40 bg-stone/60 px-3.5 py-2 text-xs sm:text-sm font-medium text-pine hover:bg-stone transition-colors"
        >
          Rejeitar não essenciais
        </button>
        <button
          type="button"
          id="cookie-btn-accept"
          class="rounded-md bg-pine px-4 py-2 text-xs sm:text-sm font-medium text-white hover:bg-pine-light transition-colors"
        >
          Aceitar todos
        </button>
      </div>
    </div>

    <!-- Painel de configuração detalhada -->
    <div id="cookie-config-panel" class="hidden mt-4 pt-4 border-t border-border">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs sm:text-sm">
        <label class="flex items-start gap-3 rounded-md border border-border bg-stone/40 p-3">
          <input type="checkbox" checked disabled class="mt-1 h-4 w-4 rounded border-border text-pine" />
          <div>
            <span class="font-semibold text-pine block">Estritamente necessários</span>
            <span class="text-xs text-graphite-muted">Essenciais para segurança, sessão do formulário e registo da sua escolha de privacidade.</span>
          </div>
        </label>

        <label class="flex items-start gap-3 rounded-md border border-border bg-white p-3 cursor-pointer">
          <input type="checkbox" id="cookie-opt-analytics" class="mt-1 h-4 w-4 rounded border-border text-pine" />
          <div>
            <span class="font-semibold text-pine block">Analíticos (GA4)</span>
            <span class="text-xs text-graphite-muted">Ajudam-nos a compreender como os visitantes utilizam o site de forma agregada.</span>
          </div>
        </label>

        <label class="flex items-start gap-3 rounded-md border border-border bg-white p-3 cursor-pointer">
          <input type="checkbox" id="cookie-opt-marketing" class="mt-1 h-4 w-4 rounded border-border text-pine" />
          <div>
            <span class="font-semibold text-pine block">Publicidade (Google Ads & Meta)</span>
            <span class="text-xs text-graphite-muted">Permitem medir conversões dos anúncios Google e Meta.</span>
          </div>
        </label>
      </div>
      <div class="mt-4 flex justify-end">
        <button
          type="button"
          id="cookie-btn-save"
          class="rounded-md bg-terracotta px-4 py-2 text-xs sm:text-sm font-medium text-white hover:bg-terracotta-dark transition-colors"
        >
          Guardar preferências
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ analyticsConfig: SITE_CONFIG.analytics }}>
  (function () {
    const STORAGE_KEY = 'pmvp_cookie_consent_v1';
    let scriptsLoaded = { analytics: false, marketing: false };

    function getConsent() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        return raw ? JSON.parse(raw) : null;
      } catch (e) {
        return null;
      }
    }

    function saveConsent(prefs) {
      const payload = {
        necessary: true,
        analytics: Boolean(prefs.analytics),
        marketing: Boolean(prefs.marketing),
        updatedAt: new Date().toISOString(),
      };
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
      } catch (e) {}
      applyConsent(payload);
      hideBanner();
    }

    function applyConsent(consent) {
      if (!consent) return;
      if (consent.analytics && !scriptsLoaded.analytics) {
        scriptsLoaded.analytics = true;
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        window.gtag('js', new Date());
        window.gtag('config', analyticsConfig.ga4MeasurementId, { anonymize_ip: true });
      }
      if (consent.marketing && !scriptsLoaded.marketing) {
        scriptsLoaded.marketing = true;
        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function () {
          window.dataLayer.push(arguments);
        };
        window.gtag('config', analyticsConfig.googleAdsId);
        // Meta Pixel queue initialization (only after consent)
        window.fbq = window.fbq || function () {
          (window.fbq.q = window.fbq.q || []).push(arguments);
        };
        window.fbq('init', analyticsConfig.metaPixelId);
        window.fbq('track', 'PageView');
      }
    }

    // Função global de tracking de eventos conforme Secção 8 da especificação
    window.pmvpTrack = function (eventName, params = {}) {
      const consent = getConsent();
      const eventPayload = {
        event: eventName,
        ...params,
        timestamp: new Date().toISOString(),
      };

      // Regista em memória para auditoria/debug sem violar RGPD
      window.__pmvpEvents = window.__pmvpEvents || [];
      window.__pmvpEvents.push(eventPayload);

      // Só dispara para GA4 / Ads / Meta se houver consentimento
      if (consent && consent.analytics && typeof window.gtag === 'function') {
        window.gtag('event', eventName, params);
      }
      if (consent && consent.marketing) {
        if (eventName === 'form_submit' || eventName === 'partner_form_submit') {
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'conversion', {
              send_to: analyticsConfig.googleAdsConversionLabel,
              ...params,
            });
          }
          if (typeof window.fbq === 'function') {
            window.fbq('track', 'Lead', params);
          }
        }
      }
    };

    function showBanner(openConfig = false) {
      const banner = document.getElementById('cookie-banner');
      const configPanel = document.getElementById('cookie-config-panel');
      if (banner) banner.classList.remove('hidden');
      if (configPanel) {
        if (openConfig) configPanel.classList.remove('hidden');
        else configPanel.classList.add('hidden');
      }
      const current = getConsent();
      const optAnalytics = document.getElementById('cookie-opt-analytics');
      const optMarketing = document.getElementById('cookie-opt-marketing');
      if (optAnalytics) optAnalytics.checked = current ? Boolean(current.analytics) : false;
      if (optMarketing) optMarketing.checked = current ? Boolean(current.marketing) : false;
    }

    function hideBanner() {
      const banner = document.getElementById('cookie-banner');
      if (banner) banner.classList.add('hidden');
    }

    document.addEventListener('DOMContentLoaded', () => {
      const existing = getConsent();
      if (!existing) {
        showBanner(false);
      } else {
        applyConsent(existing);
      }

      document.getElementById('cookie-btn-accept')?.addEventListener('click', () => {
        saveConsent({ analytics: true, marketing: true });
      });

      document.getElementById('cookie-btn-reject')?.addEventListener('click', () => {
        saveConsent({ analytics: false, marketing: false });
      });

      document.getElementById('cookie-btn-configure')?.addEventListener('click', () => {
        const panel = document.getElementById('cookie-config-panel');
        panel?.classList.toggle('hidden');
      });

      document.getElementById('cookie-btn-save')?.addEventListener('click', () => {
        const analytics = document.getElementById('cookie-opt-analytics')?.checked || false;
        const marketing = document.getElementById('cookie-opt-marketing')?.checked || false;
        saveConsent({ analytics, marketing });
      });

      document.querySelectorAll('[data-open-cookie-settings]').forEach((btn) => {
        btn.addEventListener('click', () => showBanner(true));
      });

      // Delegated listener para todos os botões com data-track-cta
      document.addEventListener('click', (e) => {
        const target = e.target && e.target.closest ? e.target.closest('[data-track-cta]') : null;
        if (target) {
          window.pmvpTrack('cta_click', {
            local: target.getAttribute('data-track-cta') || 'desconhecido',
            produto: target.getAttribute('data-track-product') || 'geral',
          });
        }
      });
    });
  })();
</script>
