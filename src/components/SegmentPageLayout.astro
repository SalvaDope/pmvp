---
import BaseLayout from '../layouts/BaseLayout.astro';
import CartographicVisual from './CartographicVisual.astro';
import FaqSection from './FaqSection.astro';

interface PainPoint {
  title: string;
  description: string;
}

interface HelpStep {
  title: string;
  description: string;
}

interface Props {
  metaTitle: string;
  metaDescription: string;
  badge: string;
  h1: string;
  lead: string;
  imageMarker: string;
  pains: PainPoint[];
  howWeHelp: HelpStep[];
  recommendedTitle: string;
  recommendedDescription: string;
  recommendedPrice: string;
  primaryCtaLabel: string;
  primaryCtaHref: string;
  secondaryCtaLabel?: string;
  secondaryCtaHref?: string;
  perfilId: string;
}

const {
  metaTitle,
  metaDescription,
  badge,
  h1,
  lead,
  imageMarker,
  pains,
  howWeHelp,
  recommendedTitle,
  recommendedDescription,
  recommendedPrice,
  primaryCtaLabel,
  primaryCtaHref,
  secondaryCtaLabel,
  secondaryCtaHref,
  perfilId,
} = Astro.props;
---

<BaseLayout title={metaTitle} description={metaDescription}>
  <!-- Hero orientado ao problema -->
  <section class="py-12 sm:py-16 lg:py-20 bg-stone/70 border-b border-border">
    <div class="container-pmvp">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-5">
          <span class="inline-block rounded-full bg-pine/10 px-3.5 py-1 text-xs font-semibold text-pine">
            {badge}
          </span>
          <h1 class="font-serif text-3xl sm:text-5xl font-semibold text-pine leading-tight">
            {h1}
          </h1>
          <p class="text-base sm:text-lg text-graphite leading-relaxed">
            {lead}
          </p>
          <div class="pt-2 flex flex-col sm:flex-row gap-3.5">
            <a
              href={primaryCtaHref}
              data-track-cta={`segment_${perfilId}_hero`}
              class="btn-primary text-base px-7 py-3.5"
            >
              {primaryCtaLabel}
            </a>
            {secondaryCtaLabel && secondaryCtaHref && (
              <a href={secondaryCtaHref} class="btn-secondary text-base px-6 py-3.5">
                {secondaryCtaLabel}
              </a>
            )}
          </div>
        </div>
        <div class="lg:col-span-5">
          <CartographicVisual marker={imageMarker} variant="cadastral" />
        </div>
      </div>
    </div>
  </section>

  <!-- 3 Dores -->
  <section class="py-16 lg:py-20 bg-white border-b border-border">
    <div class="container-pmvp">
      <div class="max-w-2xl mb-10">
        <span class="text-xs font-semibold uppercase tracking-wider text-terracotta">
          Os Riscos Mais Comuns
        </span>
        <h2 class="mt-2 font-serif text-2xl sm:text-3xl font-semibold text-pine">
          O que corre mal quando falta informação técnica
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {pains.map((pain, idx) => (
          <div class="rounded-xl border border-border bg-stone/40 p-6">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-terracotta/15 text-terracotta-dark font-mono text-xs font-bold">
              0{idx + 1}
            </span>
            <h3 class="mt-4 font-serif text-xl font-semibold text-pine">
              {pain.title}
            </h3>
            <p class="mt-2 text-sm text-graphite leading-relaxed">
              {pain.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Como ajudamos + Produto Recomendado -->
  <section class="py-16 lg:py-24 bg-stone">
    <div class="container-pmvp">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-7 space-y-6">
          <span class="text-xs font-semibold uppercase tracking-wider text-terracotta">
            Como Ajudamos
          </span>
          <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-pine">
            Informação independente para decidir sobre factos
          </h2>
          <div class="space-y-4 pt-2">
            {howWeHelp.map((step) => (
              <div class="rounded-lg border border-border bg-white p-5">
                <h3 class="font-serif text-lg font-semibold text-pine">
                  {step.title}
                </h3>
                <p class="mt-1.5 text-sm text-graphite-muted leading-relaxed">
                  {step.description}
                </p>
              </div>
            ))}
          </div>
        </div>

        <!-- Produto Recomendado -->
        <div class="lg:col-span-5">
          <div class="rounded-xl bg-pine text-white p-6 sm:p-8 shadow-lg">
            <span class="inline-block rounded bg-terracotta px-3 py-1 text-xs font-semibold uppercase tracking-wider text-white">
              Produto Recomendado
            </span>
            <h3 class="mt-4 font-serif text-2xl sm:text-3xl font-semibold text-white">
              {recommendedTitle}
            </h3>
            <p class="mt-3 text-sm sm:text-base text-stone/90 leading-relaxed">
              {recommendedDescription}
            </p>
            <div class="mt-4 pt-4 border-t border-stone/20 text-sm text-stone/85">
              <strong>Investimento:</strong> {recommendedPrice}
            </div>
            <div class="mt-6">
              <a
                href={primaryCtaHref}
                data-track-cta={`segment_${perfilId}_recommended`}
                class="btn-terracotta w-full text-base py-3.5"
              >
                {primaryCtaLabel}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FaqSection />
</BaseLayout>
