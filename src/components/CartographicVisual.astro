---
interface Props {
  marker: string;
  caption?: string;
  variant?: 'hero' | 'pdm' | 'cadastral';
}

const { marker, caption, variant = 'hero' } = Astro.props;
---

<figure class="relative overflow-hidden rounded-lg border border-border bg-pine-dark text-stone shadow-md">
  <!-- Grelha Cartográfica & Curvas de Nível SVG -->
  <div class="relative aspect-[16/10] w-full overflow-hidden bg-[#193024]">
    <svg
      class="h-full w-full object-cover opacity-90"
      viewBox="0 0 800 500"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-label={marker}
    >
      <!-- Fundo de textura de ortofoto estilizada -->
      <rect width="800" height="500" fill="#182E22" />

      <!-- Malha de coordenadas UTM / ETRS89 -->
      <g stroke="#D9D3C7" stroke-opacity="0.12" stroke-width="1">
        <line x1="0" y1="100" x2="800" y2="100" />
        <line x1="0" y1="200" x2="800" y2="200" />
        <line x1="0" y1="300" x2="800" y2="300" />
        <line x1="0" y1="400" x2="800" y2="400" />
        <line x1="160" y1="0" x2="160" y2="500" />
        <line x1="320" y1="0" x2="320" y2="500" />
        <line x1="480" y1="0" x2="480" y2="500" />
        <line x1="640" y1="0" x2="640" y2="500" />
      </g>

      <!-- Curvas de nível topográficas -->
      <g stroke="#D9D3C7" stroke-opacity="0.22" stroke-width="1.2" fill="none">
        <path d="M-40 80 C 140 60, 260 150, 440 120 C 600 90, 700 40, 840 70" />
        <path d="M-40 140 C 160 110, 280 210, 460 175 C 620 145, 720 95, 840 130" />
        <path d="M-40 210 C 180 175, 300 280, 490 240 C 650 200, 730 160, 840 195" />
        <path d="M-40 290 C 190 250, 320 350, 510 310 C 670 270, 740 230, 840 265" />
        <path d="M-40 375 C 210 330, 350 420, 540 380 C 690 340, 760 310, 840 345" />
        <path d="M-40 450 C 230 410, 380 485, 570 445 C 710 410, 770 385, 840 420" />
      </g>

      <!-- Mancha de condicionante (REN / Linha de água) -->
      <path
        d="M 80 0 C 140 140, 210 260, 170 500 L 245 500 C 285 260, 215 140, 155 0 Z"
        fill="#2C523F"
        fill-opacity="0.55"
      />
      <path
        d="M 118 0 C 178 140, 248 260, 208 500"
        stroke="#7BA791"
        stroke-width="2"
        stroke-dasharray="6 4"
      />

      <!-- Mancha de zonamento PDM -->
      {variant !== 'cadastral' && (
        <polygon
          points="320,90 660,115 690,360 370,395 280,260"
          fill="#F2EEE6"
          fill-opacity="0.08"
          stroke="#D9D3C7"
          stroke-opacity="0.35"
          stroke-width="1.5"
          stroke-dasharray="4 4"
        />
      )}

      <!-- Polígono da Parcela em Análise (Destaque Terracota) -->
      <polygon
        points="355,135 595,155 620,325 395,350 325,245"
        fill="#B5653A"
        fill-opacity="0.24"
        stroke="#B5653A"
        stroke-width="3"
      />

      <!-- Vértices cadastrais (Estremas) -->
      <g fill="#F2EEE6" stroke="#B5653A" stroke-width="2.5">
        <circle cx="355" cy="135" r="5" />
        <circle cx="595" cy="155" r="5" />
        <circle cx="620" cy="325" r="5" />
        <circle cx="395" cy="350" r="5" />
        <circle cx="325" cy="245" r="5" />
      </g>

      <!-- Etiquetas técnicas no mapa -->
      <g font-family="monospace" font-size="11" fill="#F2EEE6" fill-opacity="0.85">
        <text x="24" y="30">ETRS89 / PT-TM06 · DGT ORTOFOTO</text>
        <text x="368" y="125" fill="#F7ECE6">PARCELA EM ANÁLISE · ART.º MATRICIAL</text>
        <text x="410" y="235" font-size="13" font-weight="bold" fill="#FFFFFF">ÁREA BRUTA: 14.250 m²</text>
        <text x="410" y="255" font-size="11" fill="#F2EEE6">PDM · CONDICIONANTES (RAN / REN)</text>
        <text x="130" y="470" fill="#9RC5B0">DOMÍNIO HÍDRICO / REN</text>
      </g>

      <!-- Escala Gráfica -->
      <g transform="translate(630, 445)">
        <line x1="0" y1="10" x2="120" y2="10" stroke="#F2EEE6" stroke-width="2" />
        <line x1="0" y1="5" x2="0" y2="15" stroke="#F2EEE6" stroke-width="2" />
        <line x1="60" y1="6" x2="60" y2="14" stroke="#F2EEE6" stroke-width="1.5" />
        <line x1="120" y1="5" x2="120" y2="15" stroke="#F2EEE6" stroke-width="2" />
        <text x="0" y="0" font-family="monospace" font-size="10" fill="#F2EEE6">0</text>
        <text x="50" y="0" font-family="monospace" font-size="10" fill="#F2EEE6">50m</text>
        <text x="102" y="0" font-family="monospace" font-size="10" fill="#F2EEE6">100m</text>
      </g>
    </svg>

    <!-- Marcador explícito pedido na especificação -->
    <div class="absolute bottom-3 left-3 right-3 flex flex-wrap items-center justify-between gap-2 rounded bg-pine-dark/90 backdrop-blur px-3 py-2 border border-stone/20">
      <span class="font-mono text-xs text-terracotta-light font-medium">
        {marker}
      </span>
      <span class="text-[11px] text-stone/75">
        Cartografia técnica PMVP
      </span>
    </div>
  </div>
  {caption && (
    <figcaption class="bg-stone px-4 py-2.5 text-xs text-graphite-muted border-t border-border">
      {caption}
    </figcaption>
  )}
</figure>
