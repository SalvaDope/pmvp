---
import { SITE_CONFIG } from '../config/site';

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/servicos', label: 'Serviços' },
  {
    label: 'Para quem',
    children: [
      { href: '/para-quem/comprar', label: 'Vai comprar um terreno', desc: 'Segurança antes do CPCV' },
      { href: '/para-quem/heranca', label: 'Herdou um terreno', desc: 'Partilha ou venda fundamentada' },
      { href: '/para-quem/vender', label: 'Quer vender um terreno', desc: 'Demonstre o potencial aos compradores' },
      { href: '/parceiros', label: 'Profissionais e Parceiros', desc: 'Mediadores, advogados e solicitadores' },
    ],
  },
  { href: '/como-funciona', label: 'Como funciona' },
  { href: '/recursos', label: 'Recursos' },
  { href: '/sobre', label: 'Sobre' },
];
---

<header class="sticky top-0 z-40 w-full border-b border-border bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/90">
  <div class="container-pmvp flex h-16 sm:h-20 items-center justify-between gap-2">
    <!-- Logo -->
    <a
      href="/"
      class="group flex items-center gap-2.5 focus:outline-none shrink-0"
      aria-label={`${SITE_CONFIG.brand.name} — ${SITE_CONFIG.brand.descriptor}`}
    >
      <div class="flex h-9 w-9 sm:h-10 sm:w-10 items-center justify-center rounded bg-pine text-white font-serif font-semibold text-base sm:text-lg tracking-wider border border-pine-dark">
        PM
      </div>
      <div class="flex flex-col">
        <span class="font-serif text-lg sm:text-xl font-semibold leading-none tracking-tight text-pine">
          {SITE_CONFIG.brand.name}
        </span>
        <span class="text-[10px] sm:text-xs font-medium text-graphite-muted tracking-wide">
          {SITE_CONFIG.brand.descriptor}
        </span>
      </div>
    </a>

    <!-- Navegação Desktop -->
    <nav class="hidden lg:flex items-center gap-6" aria-label="Navegação principal">
      {navLinks.map((item) =>
        item.children ? (
          <div class="relative group">
            <button
              type="button"
              class="inline-flex items-center gap-1 py-2 text-sm font-medium text-graphite hover:text-pine transition-colors"
              aria-expanded="false"
              aria-haspopup="true"
            >
              <span>{item.label}</span>
              <svg class="h-4 w-4 text-graphite-muted group-hover:text-pine transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 transition-all duration-150 absolute left-0 top-full pt-2 w-72 z-50">
              <div class="rounded-lg border border-border bg-white p-2 shadow-lg">
                {item.children.map((sub) => (
                  <a
                    href={sub.href}
                    class:list={[
                      'block rounded-md px-3 py-2.5 transition-colors hover:bg-stone',
                      currentPath === sub.href ? 'bg-stone/70 text-pine font-semibold' : 'text-graphite',
                    ]}
                  >
                    <div class="text-sm font-medium text-pine">{sub.label}</div>
                    <div class="text-xs text-graphite-muted mt-0.5">{sub.desc}</div>
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class:list={[
              'py-2 text-sm font-medium transition-colors hover:text-pine',
              currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href!))
                ? 'text-pine font-semibold underline decoration-terracotta decoration-2 underline-offset-8'
                : 'text-graphite',
            ]}
          >
            {item.label}
          </a>
        )
      )}
    </nav>

    <!-- Ações (Botão "Analisar o meu terreno" sempre visível, inclusive no telemóvel) -->
    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href="/submeter-terreno"
        data-track-cta="header"
        data-track-product="geral"
        class="inline-flex items-center justify-center rounded-md bg-pine px-3 py-2 sm:px-4 sm:py-2.5 text-xs sm:text-sm font-medium text-white shadow-sm hover:bg-pine-light transition-colors whitespace-nowrap"
      >
        Analisar o meu terreno
      </a>

      <!-- Botão Menu Mobile -->
      <button
        type="button"
        id="mobile-menu-toggle"
        class="inline-flex lg:hidden items-center justify-center rounded-md border border-border p-2 text-graphite hover:bg-stone hover:text-pine"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Abrir menu de navegação"
      >
        <svg id="menu-icon-open" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Menu Mobile -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-border bg-white px-4 pt-3 pb-6 shadow-lg"
    aria-label="Menu móvel"
  >
    <div class="space-y-1">
      <a href="/raio-x" class="block rounded-md px-3 py-2 text-base font-medium text-pine hover:bg-stone">
        Raio-X do Terreno (190 €)
      </a>
      <a href="/estudo-de-viabilidade" class="block rounded-md px-3 py-2 text-base font-medium text-pine hover:bg-stone">
        Estudo de Viabilidade
      </a>
      <a href="/servicos" class="block rounded-md px-3 py-2 text-base font-medium text-graphite hover:bg-stone">
        Todos os Serviços
      </a>

      <div class="pt-2 pb-1 px-3 text-xs font-semibold uppercase tracking-wider text-graphite-muted">
        Para quem
      </div>
      <a href="/para-quem/comprar" class="block rounded-md pl-6 pr-3 py-2 text-sm font-medium text-graphite hover:bg-stone">
        Vai comprar um terreno
      </a>
      <a href="/para-quem/heranca" class="block rounded-md pl-6 pr-3 py-2 text-sm font-medium text-graphite hover:bg-stone">
        Herdou um terreno
      </a>
      <a href="/para-quem/vender" class="block rounded-md pl-6 pr-3 py-2 text-sm font-medium text-graphite hover:bg-stone">
        Quer vender um terreno
      </a>
      <a href="/parceiros" class="block rounded-md pl-6 pr-3 py-2 text-sm font-medium text-graphite hover:bg-stone">
        Para profissionais e parceiros
      </a>

      <div class="border-t border-border my-2 pt-2">
        <a href="/como-funciona" class="block rounded-md px-3 py-2 text-base font-medium text-graphite hover:bg-stone">
          Como funciona
        </a>
        <a href="/recursos" class="block rounded-md px-3 py-2 text-base font-medium text-graphite hover:bg-stone">
          Recursos (Artigos)
        </a>
        <a href="/sobre" class="block rounded-md px-3 py-2 text-base font-medium text-graphite hover:bg-stone">
          Sobre nós
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (toggleBtn && mobileMenu && iconOpen && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }
</script>
